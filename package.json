    "ag-grid-react": "36.2.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "dotenv": "*",
    "express": "*",
    "lucide-react": "*",
    "openai": "^7.45.1",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "*"
  }
