# Copy to .env (gitignored). Every variable the server reads is listed here.

# Local server
PORT=3000
# Public base URL of the app; PayPal returns the buyer here after approval.
APP_BASE_URL=http://localhost:3000

# PayPal Sandbox (REST app credentials from developer.paypal.com). Live hosts are refused.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_SECRET=your_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook subscription ID; required to verify webhook signatures.
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id

# Supabase (hackathon project). SUPABASE_ANON_KEY is the publishable key and reaches the browser;
# SUPABASE_SERVICE_ROLE_KEY (secret) stays on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Seat assistant model (NVIDIA hosted API, build.nvidia.com). Empty disables the seat assistant.
NVIDIA_API_KEY=

# Ask AI on Instructor analytics (Anthropic Claude). Empty disables Ask AI.
ANTHROPIC_API_KEY=
# Optional: override the Ask AI model (default in server/config.js).
STUDIO_AI_MODEL=
# Optional: set to 1 to log one timing row per Ask AI model turn.
STUDIO_AI_TIMING=

# Vercel only (Project Settings > Environment Variables, not needed locally):
# NODEJS_HELPERS=0 keeps the request body unparsed so the PayPal webhook is verified with the raw body.
# NODEJS_HELPERS=0

# Set by Vercel on every deploy (never set it yourself): VERCEL_GIT_COMMIT_SHA is reported by GET /api/health.

# Scripts only (optional): TRIALS for `npm run probe:studio-agent`, TIMEOUT_MIN for `npm run time:ask-ai`.
